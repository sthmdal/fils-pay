# Copy to ops/.env (gitignored) and fill in real values. Never commit ops/.env.
#
# Generate secrets with e.g.:
#   openssl rand -hex 24                      (passwords / tokens)
#   openssl rand -base64 32                   (WEBHOOK_SECRET_ENCRYPTION_KEY, 32 bytes)

NODE_ENV=production
PORT=3000

POSTGRES_PASSWORD=change-me

# Shared bearer token between apps/api and apps/settlement's internal API.
# Required: the settlement daemon exits at boot without it.
SETTLEMENT_INTERNAL_TOKEN=change-me

# Required by apps/api when NODE_ENV=production.
WEBHOOK_SECRET_ENCRYPTION_KEY=change-me-base64-32-bytes
ACQUIRER_CALLBACK_SIGNING_SECRET=change-me

# Unsigned acquirer callbacks are rejected by default. Only set false for a
# local sandbox that cannot sign.
ACQUIRER_CALLBACK_REQUIRE_SIGNATURE=true

# Public URL the checkout links point at.
CHECKOUT_BASE_URL=http://localhost:5173
