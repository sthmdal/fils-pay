# Image for the Node services (apps/api, apps/reporting) and the one-off
# migrate/seed jobs. Built from the repo root: context `..` in compose.
# Debian slim rather than alpine: sharp (KYC thumbnails) ships glibc builds.
# Node 22: dependencies (cookie@2) require >=22. Build tools are a fallback
# for native modules (argon2) when no prebuilt binary matches.
FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

# Workspace manifests first so `npm ci` is cached until dependencies change.
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
# Dev dependencies included: the services run through tsx.
RUN npm ci --include=dev --no-audit --no-fund

COPY packages packages
COPY apps/api apps/api
COPY apps/reporting apps/reporting
COPY db db
COPY scripts scripts

USER node
